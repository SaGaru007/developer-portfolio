{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "cd ../.. && pnpm install --filter sagar-portfolio-frontend --no-frozen-lockfile",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://portfolio-1-y0hc.onrender.com/api/$1" },
    { "source": "/uploads/(.*)", "destination": "https://portfolio-1-y0hc.onrender.com/uploads/$1" },
    { "source": "/resume", "destination": "https://portfolio-1-y0hc.onrender.com/resume" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
